{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "icon": "assets/vitrify/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "ashpapi.vitrify.fabric.VitrifyFabricClient"
    ],
    "modmenu": [
      "ashpapi.vitrify.fabric.ModMenuIntegration"
    ]
  },
  "mixins": [
    {
      "config": "vitrify.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": "*"
  }
}
